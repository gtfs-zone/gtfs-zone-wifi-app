<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext only for the connectivity probe, which a captive portal must be able to answer. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">ingest.wifi.gtfs.zone</domain>
    </domain-config>
</network-security-config>
